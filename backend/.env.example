# Copy to .env. NEVER commit .env. Generate real secrets, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DATABASE_URL=postgres://syndicma:syndicma_dev@localhost:55432/syndicma
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=14
CORS_ORIGIN=http://localhost:5173
PORT=3000
NODE_ENV=development
# Refresh cookie 'Secure' flag. Default: true when NODE_ENV=production, false otherwise.
# COOKIE_SECURE=false
